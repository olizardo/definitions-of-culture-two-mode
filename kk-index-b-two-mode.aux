\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Top 10 nodes by mean Freeman-normalized betweenness over 1000 random maximum spanning trees of each projection. Degree is the node's degree in the 2-core. Top-10 share is the percentage of trees in which the node ranks in the top ten. Concepts and definitions are ranked separately. Ties are broken at random in each tree, so the ranks below the first place are not robust: A-10 (10th, share 45\%) and A-1 (11th, share 50\%) differ by 1.1 points in mean betweenness.\relax }}{5}{table.caption.4}\protected@file@percent }
\newlabel{tab:mst-def-betweenness}{{3}{5}{Top 10 nodes by mean Freeman-normalized betweenness over 1000 random maximum spanning trees of each projection. Degree is the node's degree in the 2-core. Top-10 share is the percentage of trees in which the node ranks in the top ten. Concepts and definitions are ranked separately. Ties are broken at random in each tree, so the ranks below the first place are not robust: A-10 (10th, share 45\%) and A-1 (11th, share 50\%) differ by 1.1 points in mean betweenness.\relax }{table.caption.4}{}}
